{
	"name": "sliftui",
	"version": "0.0.1",
	"description": "Convenience alias for Slift UI. Re-exports everything from @slift/ui.",
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"ui",
		"slift",
		"number",
		"animation"
	],
	"homepage": "https://sliftui.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/slift/slift.git",
		"directory": "packages/sliftui"
	},
	"license": "MIT",
	"author": "Slift",
	"type": "module",
	"files": [
		"index.js",
		"index.d.ts"
	],
	"svelte": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"svelte": "./index.js",
			"default": "./index.js"
		}
	},
	"dependencies": {
		"@slift/ui": "workspace:^"
	},
	"peerDependencies": {
		"svelte": "^5.16.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
